# Copy this file to .env and adjust as needed. All values shown are the defaults.

# --- LLM provider: "ollama" (local, zero cost, recommended) | "groq" (free tier, needs key) | "none" (rule-based fallback, no real LLM) ---
LLM_PROVIDER=ollama

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Groq (only used when LLM_PROVIDER=groq) - get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Data
TICKETS_CSV_PATH=data/support_tickets.csv

# Anomaly thresholds
IQR_MULTIPLIER=1.5
SLA_BREACH_HOURS=24

# UI
API_BASE_URL=http://localhost:8000
